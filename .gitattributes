# FOS-Streaming Reborn - Git Attributes
# Ensures consistent line endings and proper handling of binary files

# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Shell scripts should always use LF
*.sh text eol=lf
*.bash text eol=lf

# Explicitly declare text files
*.php text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.cnf text eol=lf
*.ini text eol=lf
*.toml text eol=lf

# Documentation
*.markdown text eol=lf
README text eol=lf
LICENSE text eol=lf
AUTHORS text eol=lf
CHANGELOG text eol=lf
CONTRIBUTING text eol=lf

# PHP Composer
composer.json text eol=lf
composer.lock text eol=lf linguist-generated=true

# Node/NPM
package.json text eol=lf
package-lock.json text eol=lf linguist-generated=true
*.npmrc text eol=lf

# Git
.gitattributes text eol=lf
.gitignore text eol=lf
.gitmodules text eol=lf

# Docker
Dockerfile text eol=lf
docker-compose*.yml text eol=lf
.dockerignore text eol=lf

# Declare files that will always have CRLF (Windows scripts)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
*.mp4 binary
*.mp3 binary
*.wav binary
*.flv binary
*.webm binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.7z binary
*.rar binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# Exclude from archives (git archive)
.gitattributes export-ignore
.gitignore export-ignore
.github/ export-ignore
tests/ export-ignore
docs/dev/ export-ignore
.editorconfig export-ignore
.php-cs-fixer.php export-ignore
phpunit.xml export-ignore
phpstan.neon export-ignore

# LFS tracking for large files (if enabled)
# *.mp4 filter=lfs diff=lfs merge=lfs -text
# *.zip filter=lfs diff=lfs merge=lfs -text
