{
  "name": "cristiancasapu/fos-streaming-reborn",
  "description": "FOS-Streaming Reborn v70 - Enterprise-grade streaming and restreaming platform with advanced security",
  "version": "70.0.0",
  "type": "project",
  "keywords": [
    "streaming",
    "restreaming",
    "rtmp",
    "hls",
    "http-flv",
    "transcoding",
    "nginx-http-flv",
    "ffmpeg",
    "video-streaming",
    "live-streaming",
    "security",
    "fail2ban",
    "firewall",
    "vue3",
    "laravel",
    "php8"
  ],
  "homepage": "https://github.com/CristianCasapu/FOS-Streaming-Reborn",
  "license": "MIT",
  "authors": [
    {
      "name": "Cristian Casapu",
      "email": "cristian@casapu.com"
    },
    {
      "name": "FOS-Streaming Development Team (Original)",
      "role": "Original Authors"
    }
  ],
  "support": {
    "issues": "https://github.com/CristianCasapu/FOS-Streaming-Reborn/issues",
    "source": "https://github.com/CristianCasapu/FOS-Streaming-Reborn",
    "docs": "https://github.com/CristianCasapu/FOS-Streaming-Reborn/blob/develop/README.md"
  },
  "require": {
    "php": ">=8.4",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "guzzlehttp/guzzle": "^7.9",
    "illuminate/auth": "^11.40",
    "illuminate/cache": "^11.40",
    "illuminate/console": "^11.40",
    "illuminate/cookie": "^11.40",
    "illuminate/database": "^11.40",
    "illuminate/encryption": "^11.40",
    "illuminate/events": "^11.40",
    "illuminate/filesystem": "^11.40",
    "illuminate/hashing": "^11.40",
    "illuminate/http": "^11.40",
    "illuminate/log": "^11.40",
    "illuminate/mail": "^11.40",
    "illuminate/notifications": "^11.40",
    "illuminate/pagination": "^11.40",
    "illuminate/queue": "^11.40",
    "illuminate/redis": "^11.40",
    "illuminate/routing": "^11.40",
    "illuminate/session": "^11.40",
    "illuminate/support": "^11.40",
    "illuminate/validation": "^11.40",
    "jenssegers/blade": "^2.0",
    "monolog/monolog": "^3.9",
    "nesbot/carbon": "^3.10",
    "owen-it/laravel-auditing": "^14.0",
    "predis/predis": "^2.2",
    "spatie/laravel-permission": "^6.23",
    "symfony/var-dumper": "^7.2",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "laravel/sail": "^1.42",
    "fakerphp/faker": "^1.24",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "laravel/pint": "^1.19",
    "phpstan/phpstan": "^2.1",
    "spatie/laravel-ignition": "^2.9"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "FOS\\Security\\": "lib/"
    },
    "classmap": [
      "models"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\\\": "tests/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php -r \"echo 'Installation complete. Run security installer: bash security/install_security_features.sh\\\\n';\""
    ],
    "post-update-cmd": [
      "@php -r \"echo 'Update complete. Check CHANGELOG.md for migration notes.\\\\n';\""
    ],
    "test": [
      "Composer\\Config::disableProcessTimeout",
      "@php artisan test"
    ],
    "test:unit": "phpunit --testsuite Unit",
    "test:feature": "phpunit --testsuite Feature",
    "test:coverage": "phpunit --coverage-html coverage",
    "lint": "pint",
    "lint:test": "pint --test",
    "analyze": "phpstan analyse --memory-limit=2G",
    "format": "@lint",
    "check": [
      "@lint:test",
      "@analyze",
      "@test"
    ],
    "security-check": "bash scripts/security-check.sh",
    "organize-docs": "@php scripts/organize-docs.php",
    "serve": "@php artisan serve",
    "serve:dev": "@php artisan serve --host=0.0.0.0 --port=8000",
    "fresh": [
      "Composer\\Config::disableProcessTimeout",
      "@php artisan migrate:fresh --seed"
    ],
    "migrate": "@php artisan migrate",
    "migrate:fresh": "@fresh",
    "migrate:status": "@php artisan migrate:status",
    "db:seed": "@php artisan db:seed",
    "db:wipe": "@php artisan db:wipe --force",
    "clear-all-cache": [
      "@php -r \"array_map('unlink', glob('cache/*.php'));\"",
      "@php -r \"if (file_exists('bootstrap/cache/config.php')) unlink('bootstrap/cache/config.php');\"",
      "@php -r \"if (file_exists('bootstrap/cache/routes.php')) unlink('bootstrap/cache/routes.php');\"",
      "@php -r \"if (is_dir('storage/framework/cache/data')) { array_map('unlink', glob('storage/framework/cache/data/*/*')); }\""
    ],
    "cache:clear": "@clear-all-cache",
    "optimize": "@php -r \"echo 'No optimization needed for this application.\\n';\"",
    "ide-helper": [
      "@php artisan ide-helper:generate",
      "@php artisan ide-helper:models --nowrite"
    ],
    "check-syntax": [
      "find app models -name '*.php' -print0 | xargs -0 -n1 php -l",
      "find database -name '*.php' -print0 | xargs -0 -n1 php -l"
    ],
    "phpcs": "phpcs --standard=PSR12 app models",
    "phpcs:fix": "phpcbf --standard=PSR12 app models",
    "deploy:check": [
      "@check-syntax",
      "@lint:test",
      "@analyze",
      "@test"
    ],
    "dev": [
      "@clear-all-cache",
      "@migrate",
      "@serve"
    ],
    "prod:deploy": [
      "@composer install --no-dev --optimize-autoloader --classmap-authoritative --no-scripts",
      "@composer dump-autoload --optimize --classmap-authoritative --no-scripts",
      "@migrate --force",
      "@clear-all-cache",
      "bash scripts/rebuild-system.sh"
    ],
    "reset-staff-password": "@php scripts/reset-staff-password.php",
    "rebuild": "bash scripts/rebuild-system.sh",
    "optimize:autoload": [
      "@composer dump-autoload --optimize --classmap-authoritative",
      "@php -r \"if (extension_loaded('apcu')) { echo 'APCu available - consider using --apcu for additional optimization\n'; } else { echo 'APCu not available - classmap optimization applied\n'; }\""
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "8.4"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {
    "branch-alias": {
      "dev-develop": "70.x-dev",
      "dev-master": "70.0-stable"
    },
    "fos-streaming": {
      "version": "70.0.0",
      "release-date": "2025-11-21",
      "codename": "Security Fortress",
      "features": [
        "fail2ban integration",
        "UFW firewall management",
        "PHP 8.4 support",
        "Debian 12 compatibility",
        "Argon2id password hashing",
        "Real-time security dashboard",
        "Automatic intrusion prevention"
      ],
      "requirements": {
        "os": "Debian 12 (Bookworm)",
        "php": "8.4",
        "database": "MariaDB 11.4",
        "webserver": "Nginx 1.26+",
        "ffmpeg": "Latest static build"
      }
    }
  }
}
