# Application
APP_NAME="FOS Streaming v70"
APP_ENV=production
APP_DEBUG=false
APP_KEY=    # Laravel encryption key - Generate with: php -r "echo 'base64:' . base64_encode(random_bytes(32));"
APP_URL=https://your-domain.com
APP_DOMAIN=your-domain.com
APP_TIMEZONE=UTC

# Server Configuration (Set during installation)
# These should match your nginx configuration
WEB_PORT=8000
STREAMING_PORT=8080
RTMP_PORT=1935
HTTPS_PORT=443

# Laravel Sail (Development Only)
WWWUSER=1000
WWWGROUP=1000
APP_PORT=7777
VITE_PORT=5173

# Database (MariaDB)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=fos_streaming
DB_USERNAME=fos_user
DB_PASSWORD=CHANGEME_SECURE_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

# Redis (use 127.0.0.1 for local install, 'redis' for Docker/Sail)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Cache
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@fos-streaming.local"
MAIL_FROM_NAME="${APP_NAME}"

# Mailpit Dashboard
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# Database Ports
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379

# Security
SESSION_LIFETIME=120
CSRF_TOKEN_TIMEOUT=7200

# Admin Panel Security (IMPORTANT: Change this to a unique, hard-to-guess path)
# Examples: /control-panel-xyz, /management-abc123, /secure-admin-portal
ADMIN_PATH=/admin

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Template Paths
VIEWS_PATH=views
CACHE_PATH=cache

# Streaming Configuration
WEB_IP=*
STREAMING_AUTH=true
FAIL2BAN_ENABLED=true
UFW_ENABLED=false

# FFmpeg (Installed via apt to /usr/bin/)
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# HLS Output (update to match your installation path)
HLS_PATH=/home/fosadmin/FOS-Streaming/hl
HLS_URL_PREFIX=http://localhost:8080/hls

# Security Features
RATE_LIMIT_ENABLED=true
MAX_LOGIN_ATTEMPTS=5
LOGIN_TIMEOUT=900
SECURITY_LOGGING=true
