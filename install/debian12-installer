# ============================================================================
log_step "Step 18: Setting up Cron Job"

log_info "Adding cron job for stream monitoring..."
CRON_CMD="*/2 * * * * /usr/bin/php ${FOS_DIR}/www/cron.php"
(crontab -l 2>/dev/null | grep -v "cron.php"; echo "$CRON_CMD") | crontab -

