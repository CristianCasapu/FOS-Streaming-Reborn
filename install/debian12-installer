sudo chmod 600 "${FOS_DIR}/www/.env"
sudo chown ${FOS_USER}:${FOS_USER} "${FOS_DIR}/www/.env"

log_info "Production .env file created"

# ============================================================================
# STEP 12: Install NPM Dependencies and Build Frontend (if needed)
# ============================================================================
log_step "Step 12: Installing NPM Dependencies and Building Frontend"

if [ -f "${FOS_DIR}/www/package.json" ]; then
    log_info "package.json found, installing NPM dependencies..."

    cd "${FOS_DIR}/www"

    # Load NVM for this shell
    export NVM_DIR="$HOME/.nvm"
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

    # Install dependencies
    npm install

    # Update frontend config with admin path
    if [ -f "resources/js/config.js" ]; then
        log_info "Updating frontend config with admin path..."
        sed -i "s|export const ADMIN_PATH = '.*'|export const ADMIN_PATH = '${ADMIN_PATH}'|" resources/js/config.js
        log_info "Frontend config updated"
    fi

    # Build production assets
    if grep -q "\"build\":" package.json; then
        log_info "Running npm run build..."
        npm run build
        log_info "Frontend assets built successfully"
    else
        log_warn "No build script found in package.json, skipping build step"
    fi
else
    log_info "No package.json found, skipping NPM setup"
fi

# ============================================================================
# STEP 13: Configure Application
# ============================================================================
log_step "Step 13: Configuring FOS-Streaming Application"

# Update database configuration
log_info "Updating database configuration..."
sudo sed -i "s/'xxx'/'fos_streaming'/g" "${FOS_DIR}/www/config.php"
sudo sed -i "s/'zzz'/'${SQL_PASSWD}'/g" "${FOS_DIR}/www/config.php"
sudo sed -i "s/'ttt'/'fos'/g" "${FOS_DIR}/www/config.php"

# Create required directories
log_info "Creating application directories..."
sudo mkdir -p "${FOS_DIR}/www/config"
sudo mkdir -p "${FOS_DIR}/www/lib"
sudo mkdir -p "${FOS_DIR}/www/hl"
sudo chmod 777 "${FOS_DIR}/www/hl"
sudo mkdir -p "${FOS_DIR}/www/cache"
sudo chmod 777 "${FOS_DIR}/www/cache"
sudo mkdir -p "${FOS_DIR}/www/storage/framework/cache"
sudo mkdir -p "${FOS_DIR}/www/storage/framework/sessions"
sudo mkdir -p "${FOS_DIR}/www/storage/framework/views"
sudo mkdir -p "${FOS_DIR}/www/storage/logs"
sudo chmod -R 775 "${FOS_DIR}/www/storage"
sudo mkdir -p "${FOS_DIR}/www1/log"
sudo mkdir -p "${FOS_DIR}/logs"

# Save port configuration
log_info "Saving port configuration..."
sudo tee "${FOS_DIR}/www/config/ports.php" > /dev/null <<EOF
<?php
/**
 * FOS-Streaming Port Configuration
 * Generated: $(date '+%Y-%m-%d %H:%M:%S')
 */

return [
    'web_port' => ${WEB_PORT},
    'stream_port' => ${STREAM_PORT},
    'rtmp_port' => ${RTMP_PORT},
];
EOF

sudo chmod 644 "${FOS_DIR}/www/config/ports.php"

# Setup www1 directory for streaming
log_info "Setting up streaming directory..."
sudo cp -R "${FOS_DIR}/www/"* "${FOS_DIR}/www1/" 2>/dev/null || true
sudo rm -rf "${FOS_DIR}/www1/"*.* "${FOS_DIR}/www1/hl" 2>/dev/null || true

# Create symbolic links
sudo ln -sf "${FOS_DIR}/www/hl" "${FOS_DIR}/www1/hl"
sudo ln -sf "${FOS_DIR}/www/config.php" "${FOS_DIR}/www1/config.php"
sudo ln -sf "${FOS_DIR}/www/functions.php" "${FOS_DIR}/www1/functions.php"
sudo ln -sf "${FOS_DIR}/www/stream.php" "${FOS_DIR}/www1/stream.php"
sudo ln -sf "${FOS_DIR}/www/playlist.php" "${FOS_DIR}/www1/playlist.php"

# Create PHP symlink
sudo mkdir -p "${FOS_DIR}/php/bin"
sudo ln -sf /usr/bin/php "${FOS_DIR}/php/bin/php"

# Set permissions
log_info "Setting permissions..."
sudo chown -R nginx:nginx "${FOS_DIR}/www"
sudo chown -R nginx:nginx "${FOS_DIR}/www1"
sudo chown -R fosstreaming:fosstreaming "${FOS_DIR}/nginx"
sudo chown -R nginx:nginx "${FOS_DIR}/logs"

# ============================================================================
# STEP 14: Install FFmpeg
# ============================================================================
log_step "Step 14: Installing FFmpeg"

log_info "Downloading latest FFmpeg static build..."
wget -q "https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz" -O /tmp/ffmpeg-release-amd64-static.tar.xz

log_info "Extracting FFmpeg..."
tar -xJf /tmp/ffmpeg-release-amd64-static.tar.xz -C /tmp/

log_info "Installing FFmpeg binaries..."
sudo cp /tmp/ffmpeg-*/ffmpeg /usr/local/bin/ffmpeg
sudo cp /tmp/ffmpeg-*/ffprobe /usr/local/bin/ffprobe
sudo chmod 755 /usr/local/bin/ffmpeg
sudo chmod 755 /usr/local/bin/ffprobe

rm -rf /tmp/ffmpeg-*

# Detect FFmpeg and FFprobe paths
log_info "Detecting FFmpeg and FFprobe paths..."
FFMPEG_BIN=$(which ffmpeg 2>/dev/null || echo "/usr/local/bin/ffmpeg")
FFPROBE_BIN=$(which ffprobe 2>/dev/null || echo "/usr/local/bin/ffprobe")

# Verify the binaries exist and are executable
if [ ! -x "$FFMPEG_BIN" ]; then
    log_error "FFmpeg not found or not executable at: $FFMPEG_BIN"
    exit 1
fi

if [ ! -x "$FFPROBE_BIN" ]; then
    log_error "FFprobe not found or not executable at: $FFPROBE_BIN"
    exit 1
fi

log_success "FFmpeg detected at: ${FFMPEG_BIN}"
log_success "FFprobe detected at: ${FFPROBE_BIN}"

# Verify versions
FFMPEG_VERSION=$($FFMPEG_BIN -version 2>/dev/null | head -n1 | awk '{print $3}')
log_info "FFmpeg version: ${FFMPEG_VERSION}"

# Add to sudoers for nginx and fosstreaming users
log_info "Configuring FFmpeg sudo access..."
echo "nginx ALL = (root) NOPASSWD: ${FFMPEG_BIN}" | sudo tee -a /etc/sudoers.d/fos-ffmpeg > /dev/null
echo "nginx ALL = (root) NOPASSWD: ${FFPROBE_BIN}" | sudo tee -a /etc/sudoers.d/fos-ffmpeg > /dev/null
echo "${FOS_USER} ALL = (root) NOPASSWD: ${FFMPEG_BIN}" | sudo tee -a /etc/sudoers.d/fos-ffmpeg > /dev/null
echo "${FOS_USER} ALL = (root) NOPASSWD: ${FFPROBE_BIN}" | sudo tee -a /etc/sudoers.d/fos-ffmpeg > /dev/null
sudo chmod 0440 /etc/sudoers.d/fos-ffmpeg

# ============================================================================
# STEP 15: Configure Nginx and SSL Certificates
# ============================================================================
log_step "Step 15: Configuring Nginx and SSL Certificates"

log_info "Generating self-signed certificate for ${DOMAIN_NAME}..."
generate_self_signed_cert "${DOMAIN_NAME}" "${CERTS_DIR}"

log_info "Configuring nginx with domain: ${DOMAIN_NAME}, ports - Web: ${WEB_PORT}, Stream: ${STREAM_PORT}, RTMP: ${RTMP_PORT}..."

# Update HTTPS ports in nginx config
sudo sed -i "s/listen 8000;/listen ${STREAM_PORT} ssl http2;/g" "${FOS_DIR}/nginx/conf/nginx.conf"
sudo sed -i "s/listen \[::\]:8000;/listen [::]:${STREAM_PORT} ssl http2;/g" "${FOS_DIR}/nginx/conf/nginx.conf"
sudo sed -i "s/listen 7777;/listen ${WEB_PORT} ssl http2;/g" "${FOS_DIR}/nginx/conf/nginx.conf"
sudo sed -i "s/listen \[::\]:7777;/listen [::]:${WEB_PORT} ssl http2;/g" "${FOS_DIR}/nginx/conf/nginx.conf"
sudo sed -i "s/listen 1935;/listen ${RTMP_PORT};/g" "${FOS_DIR}/nginx/conf/nginx.conf"

# Add server_name configuration
sudo sed -i "/listen ${STREAM_PORT} ssl http2;/a\\
        server_name ${DOMAIN_NAME};" "${FOS_DIR}/nginx/conf/nginx.conf"
sudo sed -i "/listen ${WEB_PORT} ssl http2;/a\\
        server_name ${DOMAIN_NAME};" "${FOS_DIR}/nginx/conf/nginx.conf"

# Add SSL configuration
sudo sed -i "/server_name ${DOMAIN_NAME};/a\\
\\
        ssl_certificate ${CERTS_DIR}/fullchain.pem;\\
        ssl_certificate_key ${CERTS_DIR}/privkey.pem;\\
        ssl_protocols TLSv1.2 TLSv1.3;\\
        ssl_ciphers HIGH:!aNULL:!MD5;\\
        ssl_prefer_server_ciphers on;" "${FOS_DIR}/nginx/conf/nginx.conf"

sudo chown -R fosstreaming:fosstreaming "${FOS_DIR}/nginx/conf"
sudo chown -R fosstreaming:fosstreaming "${CERTS_DIR}"

# ============================================================================
# STEP 16: Configure System Startup
# ============================================================================
log_step "Step 16: Configuring System Startup"

sudo tee /etc/systemd/system/fos-nginx.service > /dev/null <<EOF
[Unit]
Description=FOS-Streaming Nginx Server
After=network.target

[Service]
Type=forking
User=fosstreaming
Group=fosstreaming
PIDFile=${FOS_DIR}/nginx/pid/nginx.pid
ExecStartPre=${FOS_DIR}/nginx/sbin/nginx -t -c ${FOS_DIR}/nginx/conf/nginx.conf
ExecStart=${FOS_DIR}/nginx/sbin/nginx -c ${FOS_DIR}/nginx/conf/nginx.conf
ExecReload=/bin/kill -s HUP \$MAINPID
ExecStop=/bin/kill -s QUIT \$MAINPID
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
EOF

sudo systemctl daemon-reload
sudo systemctl enable fos-nginx
sudo systemctl enable php${PHP_VERSION}-fpm

sudo systemctl stop fos-nginx 2>/dev/null || true
sudo systemctl stop php${PHP_VERSION}-fpm 2>/dev/null || true

log_info "Starting services..."
sudo systemctl start php${PHP_VERSION}-fpm
sleep 2
sudo systemctl start fos-nginx

