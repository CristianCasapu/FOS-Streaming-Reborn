    sudo ufw allow ${WEB_PORT}/tcp comment 'FOS Web Panel HTTPS'
    sudo ufw allow ${STREAM_PORT}/tcp comment 'FOS Streaming HTTPS'
    sudo ufw allow ${RTMP_PORT}/tcp comment 'FOS RTMP'
fi

sudo chmod 600 "${FOS_DIR}/www/config.php"
sudo chmod 644 "${FOS_DIR}/www/config/ports.php"
sudo chmod 600 /root/MYSQL_ROOT_PASSWORD

