# FOS-Streaming Reborn v70 - Nginx Configuration
# Optimized for Debian 12 with HTTP-FLV and RTMP streaming

user fosstreaming fosstreaming;
worker_processes auto;
error_log /home/fosstreaming/fos/nginx/logs/error.log warn;
pid /home/fosstreaming/fos/nginx/logs/nginx.pid;

events {
    worker_connections 4096;
    use epoll;
    multi_accept on;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  /home/fosstreaming/fos/nginx/logs/access.log  main;

    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout  65;
    types_hash_max_size 2048;
    client_max_body_size 500M;

    # Gzip compression
    gzip  on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript
               application/json application/javascript application/xml+rss
               application/rss+xml font/truetype font/opentype
               application/vnd.ms-fontobject image/svg+xml;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    # PHP-FPM upstream
    upstream php-fpm {
        server unix:/run/php/php8.2-fpm.sock;
    }

    # Main web server
    server {
        listen 80;
        listen [::]:80;
        server_name _;

        root /home/fosstreaming/fos/www/public;
        index index.php index.html;

        # Logging
        access_log /home/fosstreaming/fos/nginx/logs/web-access.log;
        error_log /home/fosstreaming/fos/nginx/logs/web-error.log;

        # Security: Deny access to hidden files
        location ~ /\. {
            deny all;
        }

        # Security: Deny access to sensitive files
        location ~ /(composer\.(json|lock)|package(-lock)?\.json|\.env|\.git) {
            deny all;
        }

        # Serve static files directly
        location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {
            expires 30d;
            add_header Cache-Control "public, immutable";
        }

        # PHP handling
        location ~ \.php$ {
            try_files $uri =404;
            fastcgi_pass php-fpm;
            fastcgi_index index.php;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            include fastcgi_params;

            # PHP FastCGI configuration
            fastcgi_connect_timeout 300s;
            fastcgi_send_timeout 300s;
            fastcgi_read_timeout 300s;
            fastcgi_buffer_size 128k;
            fastcgi_buffers 256 16k;
            fastcgi_busy_buffers_size 256k;
            fastcgi_temp_file_write_size 256k;
        }

        # Front controller pattern for Vue SPA
        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }
    }

    # HTTP-FLV streaming server
    server {
        listen 8000;
        listen [::]:8000;
        server_name _;

        # Logging
        access_log /home/fosstreaming/fos/nginx/logs/stream-access.log;
        error_log /home/fosstreaming/fos/nginx/logs/stream-error.log;

        # CORS headers for streaming
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods 'GET, POST, OPTIONS' always;
        add_header Access-Control-Allow-Headers 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range' always;

        # HTTP-FLV location
        location /flv {
            flv_live on;
            chunked_transfer_encoding on;
            add_header Access-Control-Allow-Origin * always;
            add_header Access-Control-Allow-Credentials true always;
        }

        # HLS location
        location /hls {
            types {
                application/vnd.apple.mpegurl m3u8;
                video/mp2t ts;
            }
            root /tmp;
            add_header Cache-Control no-cache;
            add_header Access-Control-Allow-Origin * always;
        }

        # DASH location
        location /dash {
            root /tmp;
            add_header Cache-Control no-cache;
            add_header Access-Control-Allow-Origin * always;
        }

        # Statistics
        location /stat {
            rtmp_stat all;
            rtmp_stat_stylesheet stat.xsl;
        }

        location /stat.xsl {
            root /home/fosstreaming/fos/nginx/html;
        }

        # Control endpoint
        location /control {
            rtmp_control all;
            add_header Access-Control-Allow-Origin * always;
        }
    }
}

# RTMP streaming configuration
rtmp {
    server {
        listen 1935;
        chunk_size 4096;
        max_message 10M;
        buflen 5s;

        # Main live application
        application live {
            live on;
            record off;

            # Enable HLS
            hls on;
            hls_path /tmp/hls;
            hls_fragment 3s;
            hls_playlist_length 60s;

            # Enable DASH
            dash on;
            dash_path /tmp/dash;

            # Authentication (optional)
            # on_publish http://localhost/api/stream-auth;

            # Notifications
            # on_publish_done http://localhost/api/stream-end;
            # on_play http://localhost/api/stream-play;
        }

        # Transcoded streams
        application transcoded {
            live on;
            record off;

            hls on;
            hls_path /tmp/hls_transcoded;
            hls_fragment 3s;
            hls_playlist_length 60s;
        }
    }
}
